+set(XMP_EXTRA_BUILDMACHINE"Buildmachine is x86_64")
+if(CENTOS)
+set(XMP_PLATFORM_FOLDER "i80386linux_x64_centos")
+else()
+set(XMP_PLATFORM_FOLDER "i80386linux_x64") # add XMP_BUILDMODE_DIR to follow what other platforms do
+endif()
+elseif (${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm64")
+# 64-bit ARM
+set(XMP_EXTRA_BUILDMACHINE"Buildmachine is aarch64")
+if(CENTOS)
+set(XMP_PLATFORM_FOLDER "aarch64linux_centos")
+else()
+set(XMP_PLATFORM_FOLDER "aarch64linux")
+endif()
+else()
+# 32-bit x86 or other
+set(XMP_EXTRA_BUILDMACHINE"Buildmachine is 32bit")
+if(CENTOS)
+set(XMP_PLATFORM_FOLDER "i80386linux_centos")
+else()
+set(XMP_PLATFORM_FOLDER "i80386linux") # add XMP_BUILDMODE_DIR to follow what other platforms do
+endif()
+endif()
+
+# Don't force -m32 or -m64, let the compiler use its default based on the toolchain
