include_guard(GLOBAL)
include(CMakeFindDependencyMacro)

find_dependency(EXPAT CONFIG)
find_dependency(ZLIB)

get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

if(WIN32)
  set(_XMPCORE_DEBUG   "${_IMPORT_PREFIX}/debug/lib/staticXMPCore.lib")
  set(_XMPCORE_RELEASE "${_IMPORT_PREFIX}/lib/staticXMPCore.lib")
  set(_XMPFILES_DEBUG   "${_IMPORT_PREFIX}/debug/lib/staticXMPFiles.lib")
  set(_XMPFILES_RELEASE "${_IMPORT_PREFIX}/lib/staticXMPFiles.lib")
else()
  set(_XMPCORE_DEBUG   "${_IMPORT_PREFIX}/debug/lib/libstaticXMPCore.a")
  set(_XMPCORE_RELEASE "${_IMPORT_PREFIX}/lib/libstaticXMPCore.a")
  set(_XMPFILES_DEBUG   "${_IMPORT_PREFIX}/debug/lib/libstaticXMPFiles.a")
  set(_XMPFILES_RELEASE "${_IMPORT_PREFIX}/lib/libstaticXMPFiles.a")
endif()

add_library(adobe::XMPCore STATIC IMPORTED)
set_target_properties(adobe::XMPCore PROPERTIES
  IMPORTED_CONFIGURATIONS "DEBUG;RELEASE;RELWITHDEBINFO;MINSIZEREL"
  IMPORTED_LOCATION_DEBUG "${_XMPCORE_DEBUG}"
  IMPORTED_LOCATION_RELEASE "${_XMPCORE_RELEASE}"
  IMPORTED_LOCATION_RELWITHDEBINFO "${_XMPCORE_RELEASE}"
  IMPORTED_LOCATION_MINSIZEREL "${_XMPCORE_RELEASE}"
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
)
target_link_libraries(adobe::XMPCore INTERFACE expat::expat)

add_library(adobe::XMPFiles STATIC IMPORTED)
set_target_properties(adobe::XMPFiles PROPERTIES
  IMPORTED_CONFIGURATIONS "DEBUG;RELEASE;RELWITHDEBINFO;MINSIZEREL"
  IMPORTED_LOCATION_DEBUG "${_XMPFILES_DEBUG}"
  IMPORTED_LOCATION_RELEASE "${_XMPFILES_RELEASE}"
  IMPORTED_LOCATION_RELWITHDEBINFO "${_XMPFILES_RELEASE}"
  IMPORTED_LOCATION_MINSIZEREL "${_XMPFILES_RELEASE}"
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
)
target_link_libraries(adobe::XMPFiles INTERFACE adobe::XMPCore expat::expat ZLIB::ZLIB)
