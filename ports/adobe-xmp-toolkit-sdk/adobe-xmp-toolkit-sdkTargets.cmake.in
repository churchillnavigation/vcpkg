include_guard(GLOBAL)
include(CMakeFindDependencyMacro)

find_dependency(EXPAT CONFIG)
find_dependency(ZLIB)

get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

if(WIN32)
  set(_XMPCORE_STATIC_DEBUG   "${_IMPORT_PREFIX}/debug/lib/staticXMPCore.lib")
  set(_XMPCORE_STATIC_RELEASE "${_IMPORT_PREFIX}/lib/staticXMPCore.lib")
  set(_XMPCORE_SHARED_DEBUG   "${_IMPORT_PREFIX}/debug/bin/XMPCore.dll")
  set(_XMPCORE_SHARED_RELEASE "${_IMPORT_PREFIX}/bin/XMPCore.dll")
  set(_XMPCORE_IMPLIB_DEBUG   "${_IMPORT_PREFIX}/debug/lib/XMPCore.lib")
  set(_XMPCORE_IMPLIB_RELEASE "${_IMPORT_PREFIX}/lib/XMPCore.lib")

  set(_XMPFILES_STATIC_DEBUG   "${_IMPORT_PREFIX}/debug/lib/staticXMPFiles.lib")
  set(_XMPFILES_STATIC_RELEASE "${_IMPORT_PREFIX}/lib/staticXMPFiles.lib")
  set(_XMPFILES_SHARED_DEBUG   "${_IMPORT_PREFIX}/debug/bin/XMPFiles.dll")
  set(_XMPFILES_SHARED_RELEASE "${_IMPORT_PREFIX}/bin/XMPFiles.dll")
  set(_XMPFILES_IMPLIB_DEBUG   "${_IMPORT_PREFIX}/debug/lib/XMPFiles.lib")
  set(_XMPFILES_IMPLIB_RELEASE "${_IMPORT_PREFIX}/lib/XMPFiles.lib")
else()
  if(APPLE)
    set(_SHARED_EXT ".dylib")
  else()
    set(_SHARED_EXT ".so")
  endif()
  set(_XMPCORE_STATIC_DEBUG   "${_IMPORT_PREFIX}/debug/lib/libstaticXMPCore.a")
  set(_XMPCORE_STATIC_RELEASE "${_IMPORT_PREFIX}/lib/libstaticXMPCore.a")
  set(_XMPCORE_SHARED_DEBUG   "${_IMPORT_PREFIX}/debug/lib/libXMPCore${_SHARED_EXT}")
  set(_XMPCORE_SHARED_RELEASE "${_IMPORT_PREFIX}/lib/libXMPCore${_SHARED_EXT}")

  set(_XMPFILES_STATIC_DEBUG   "${_IMPORT_PREFIX}/debug/lib/libstaticXMPFiles.a")
  set(_XMPFILES_STATIC_RELEASE "${_IMPORT_PREFIX}/lib/libstaticXMPFiles.a")
  set(_XMPFILES_SHARED_DEBUG   "${_IMPORT_PREFIX}/debug/lib/libXMPFiles${_SHARED_EXT}")
  set(_XMPFILES_SHARED_RELEASE "${_IMPORT_PREFIX}/lib/libXMPFiles${_SHARED_EXT}")
endif()

set(_XMPCORE_IS_STATIC FALSE)
if(EXISTS "${_XMPCORE_STATIC_RELEASE}")
  set(_XMPCORE_IS_STATIC TRUE)
endif()

set(_XMPFILES_IS_STATIC FALSE)
if(EXISTS "${_XMPFILES_STATIC_RELEASE}")
  set(_XMPFILES_IS_STATIC TRUE)
endif()

if(_XMPCORE_IS_STATIC)
add_library(adobe::XMPCore STATIC IMPORTED)
else()
  add_library(adobe::XMPCore SHARED IMPORTED)
endif()
set_target_properties(adobe::XMPCore PROPERTIES
  IMPORTED_CONFIGURATIONS "DEBUG;RELEASE;RELWITHDEBINFO;MINSIZEREL"
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
)
if(_XMPCORE_IS_STATIC)
  set_target_properties(adobe::XMPCore PROPERTIES
    IMPORTED_LOCATION_DEBUG "${_XMPCORE_STATIC_DEBUG}"
    IMPORTED_LOCATION_RELEASE "${_XMPCORE_STATIC_RELEASE}"
    IMPORTED_LOCATION_RELWITHDEBINFO "${_XMPCORE_STATIC_RELEASE}"
    IMPORTED_LOCATION_MINSIZEREL "${_XMPCORE_STATIC_RELEASE}"
  )
else()
  set_target_properties(adobe::XMPCore PROPERTIES
    IMPORTED_LOCATION_DEBUG "${_XMPCORE_SHARED_DEBUG}"
    IMPORTED_LOCATION_RELEASE "${_XMPCORE_SHARED_RELEASE}"
    IMPORTED_LOCATION_RELWITHDEBINFO "${_XMPCORE_SHARED_RELEASE}"
    IMPORTED_LOCATION_MINSIZEREL "${_XMPCORE_SHARED_RELEASE}"
  )
  if(WIN32)
    set_target_properties(adobe::XMPCore PROPERTIES
      IMPORTED_IMPLIB_DEBUG "${_XMPCORE_IMPLIB_DEBUG}"
      IMPORTED_IMPLIB_RELEASE "${_XMPCORE_IMPLIB_RELEASE}"
      IMPORTED_IMPLIB_RELWITHDEBINFO "${_XMPCORE_IMPLIB_RELEASE}"
      IMPORTED_IMPLIB_MINSIZEREL "${_XMPCORE_IMPLIB_RELEASE}"
    )
  endif()
endif()
target_link_libraries(adobe::XMPCore INTERFACE expat::expat)

if(_XMPFILES_IS_STATIC)
  add_library(adobe::XMPFiles STATIC IMPORTED)
else()
  add_library(adobe::XMPFiles SHARED IMPORTED)
endif()
set_target_properties(adobe::XMPFiles PROPERTIES
  IMPORTED_CONFIGURATIONS "DEBUG;RELEASE;RELWITHDEBINFO;MINSIZEREL"
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
)
if(_XMPFILES_IS_STATIC)
  set_target_properties(adobe::XMPFiles PROPERTIES
    IMPORTED_LOCATION_DEBUG "${_XMPFILES_STATIC_DEBUG}"
    IMPORTED_LOCATION_RELEASE "${_XMPFILES_STATIC_RELEASE}"
    IMPORTED_LOCATION_RELWITHDEBINFO "${_XMPFILES_STATIC_RELEASE}"
    IMPORTED_LOCATION_MINSIZEREL "${_XMPFILES_STATIC_RELEASE}"
  )
else()
  set_target_properties(adobe::XMPFiles PROPERTIES
    IMPORTED_LOCATION_DEBUG "${_XMPFILES_SHARED_DEBUG}"
    IMPORTED_LOCATION_RELEASE "${_XMPFILES_SHARED_RELEASE}"
    IMPORTED_LOCATION_RELWITHDEBINFO "${_XMPFILES_SHARED_RELEASE}"
    IMPORTED_LOCATION_MINSIZEREL "${_XMPFILES_SHARED_RELEASE}"
  )
  if(WIN32)
    set_target_properties(adobe::XMPFiles PROPERTIES
      IMPORTED_IMPLIB_DEBUG "${_XMPFILES_IMPLIB_DEBUG}"
      IMPORTED_IMPLIB_RELEASE "${_XMPFILES_IMPLIB_RELEASE}"
      IMPORTED_IMPLIB_RELWITHDEBINFO "${_XMPFILES_IMPLIB_RELEASE}"
      IMPORTED_IMPLIB_MINSIZEREL "${_XMPFILES_IMPLIB_RELEASE}"
    )
  endif()
endif()
target_link_libraries(adobe::XMPFiles INTERFACE adobe::XMPCore expat::expat ZLIB::ZLIB)
