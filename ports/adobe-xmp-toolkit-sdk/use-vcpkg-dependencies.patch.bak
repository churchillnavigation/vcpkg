diff -Naur XMP-Toolkit-SDK-orig/XMPCore/build/CMakeLists.txt XMP-Toolkit-SDK-patched/XMPCore/build/CMakeLists.txt
--- XMP-Toolkit-SDK-orig/XMPCore/build/CMakeLists.txt	2025-03-28 09:49:20.000000000 +0000
+++ XMP-Toolkit-SDK-patched/XMPCore/build/CMakeLists.txt	2026-02-20 18:10:35.906676828 +0000
@@ -53,8 +53,9 @@
 	add_definitions(-DBUILDING_XMPCORE_AS_DYNAMIC=1)
 endif()
 
+# Use vcpkg dependencies
+find_package(EXPAT REQUIRED)
 set(TP_ZUID_PATH "${XMPROOT_DIR}/third-party/zuid/interfaces")
-set(TP_EXPAT_PATH "${PROJECT_ROOT}/../../third-party/expat/lib/")
 
 # ==============================================================================
 # Project specific config starts here
diff -Naur XMP-Toolkit-SDK-orig/XMPCore/build/CMakeListsCommon.txt XMP-Toolkit-SDK-patched/XMPCore/build/CMakeListsCommon.txt
--- XMP-Toolkit-SDK-orig/XMPCore/build/CMakeListsCommon.txt	2025-03-28 09:49:20.000000000 +0000
+++ XMP-Toolkit-SDK-patched/XMPCore/build/CMakeListsCommon.txt	2026-02-20 18:11:02.119808619 +0000
@@ -87,13 +87,9 @@
 list (REMOVE_ITEM CORECLASS_SOURCE_FILES ${SOURCE_ROOT}/XMPCore_Impl.cpp)
 source_group("Source Files\\Core Classes" FILES ${CORECLASS_SOURCE_FILES})
 
+# Keep zuid, remove expat sources (use vcpkg)
 file (GLOB ZUID_SOURCE_FILES ${TP_ZUID_PATH}/*.cpp)
-list (APPEND THIRDPARTY_SOURCE_FILES
-	${TP_EXPAT_PATH}/xmlparse.c
-	${TP_EXPAT_PATH}/xmlrole.c
-	${TP_EXPAT_PATH}/xmltok.c
-	${ZUID_SOURCE_FILES}
-	)
+list (APPEND THIRDPARTY_SOURCE_FILES ${ZUID_SOURCE_FILES})
 if(WIN32)
 	list (APPEND THIRDPARTY_SOURCE_FILES ${RESOURCE_ROOT}/win/expat_config.h)
 else()
@@ -155,7 +151,6 @@
 # include directories
 include_directories(${XMPROOT_DIR})
 include_directories(${XMPROOT_DIR}/public/include)
-include_directories(${XMPROOT_DIR}/third-party/expat/public/lib)
 include_directories(${RESOURCE_ROOT}/${XMP_PLATFORM_SHORT})
 if(UNIX AND NOT APPLE AND NOT ${XMP_BUILD_STATIC})
 include_directories(${XMPROOT_DIR}/XMPCore/third-party/boost)
@@ -235,6 +230,8 @@
 # Link dependencies
 set(FRAMEWORK_LIST "ALL:CoreFoundation" "Mac:CoreServices")
 AddMacFramework(${TARGET_NAME} FRAMEWORK_LIST)
+# Link with expat from vcpkg
+target_link_libraries(${TARGET_NAME} EXPAT::EXPAT)
 if(WIN32)
 	SetWinLinkFlags(${TARGET_NAME} "rpcrt4.lib ole32.lib" "${XMPCORE_LIB}")
 else(WIN32)
