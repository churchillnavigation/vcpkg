@@ -306,6 +273,9 @@
 set(FRAMEWORK_LIST "ALL:CoreFoundation" "Mac:CoreServices" "ALL:${LIB_ADOBEXMP}" "ALL:${XMP_PLATFORM_LINK}")
 AddMacFramework(${TARGET_NAME} FRAMEWORK_LIST)
 
