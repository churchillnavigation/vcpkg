-        include/third_party/spdlog
-        include/third_party/cmdline
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include/third_party/FastCRC>
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include/third_party/spdlog>
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include/third_party/cmdline>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/third_party/FastCRC>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/third_party/spdlog>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/third_party/cmdline>
         PRIVATE
-        src)
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>)

 set_target_properties(${SDK_LIBRARY} PROPERTIES PUBLIC_HEADER "include/livox_def.h;include/livox_sdk.h")
@@ -85,7 +91,49 @@ target_sources(${SDK_LIBRARY}
         src/base/wake_up/${PLATFORM}/wake_up_pipe.cpp)


+# Install third-party headers
+install(DIRECTORY include/third_party/
+        DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/third_party
+        FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp")
+
 install(TARGETS ${SDK_LIBRARY}
+        EXPORT livox_sdk-targets
         PUBLIC_HEADER DESTINATION include
         ARCHIVE DESTINATION lib
         LIBRARY DESTINATION lib)
+
+# Export targets
+install(EXPORT livox_sdk-targets
+        FILE livox_sdk-targets.cmake
+        NAMESPACE livox_sdk::
+        DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/livox_sdk)
+
+# Create and install config file
+include(CMakePackageConfigHelpers)
+
+configure_package_config_file(
+    ${CMAKE_CURRENT_LIST_DIR}/livox_sdk-config.cmake.in
+    ${CMAKE_CURRENT_BINARY_DIR}/livox_sdk-config.cmake
+    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/livox_sdk
+)
+
+write_basic_package_version_file(
+    ${CMAKE_CURRENT_BINARY_DIR}/livox_sdk-config-version.cmake
+    VERSION ${LIVOX_SDK_VERSION_STRING}
+    COMPATIBILITY SameMajorVersion
+)
+
+install(FILES
+    ${CMAKE_CURRENT_BINARY_DIR}/livox_sdk-config.cmake
+    ${CMAKE_CURRENT_BINARY_DIR}/livox_sdk-config-version.cmake
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/livox_sdk
+)
